# =============================================================================
# RAGAvvocati — environment variables reference.
# This is a single Next.js app: copy these into frontend/.env.local (local) or
# set them in the Vercel dashboard (production). NEVER commit a filled-in file.
# =============================================================================

# ---- Supabase (create the project in an EU region for GDPR data residency) ---
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...        # public/anon key (safe for the browser)

# ---- Google Gemini (server-only: embeddings + generation) -------------------
# Get a key at: https://aistudio.google.com/app/apikey
# Models used: text-embedding-004 (768 dims) + gemini-2.5-flash
GOOGLE_API_KEY=AIza...
