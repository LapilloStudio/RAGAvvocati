# =============================================================================
# RAGAvvocati — shared reference of environment variables
# Copy the relevant blocks into backend/.env and frontend/.env.local.
# NEVER commit a filled-in .env file. Keys live only in your secret manager.
# =============================================================================

# ---- Supabase (project: create in EU region for GDPR data residency) --------
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=ey...                 # public/anon key (safe for the browser)
SUPABASE_SERVICE_ROLE_KEY=ey...         # secret — backend only, bypasses RLS
SUPABASE_JWT_SECRET=super-secret-jwt    # for verifying user access tokens (HS256)

# ---- Gemini (generation) ----------------------------------------------------
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# ---- Embeddings provider (pluggable) ----------------------------------------
# Default impl calls a managed multilingual embeddings API. Swap freely.
EMBEDDINGS_PROVIDER=managed              # managed | fake (tests) | selfhosted
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-large
EMBEDDINGS_DIMENSION=1536                # MUST match the vector(N) column size

# ---- App ---------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
