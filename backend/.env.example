# Backend environment. Copy to backend/.env and fill in. NEVER commit .env.

# ---- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...        # secret — backend only (bypasses RLS)
SUPABASE_JWT_SECRET=super-secret-jwt   # verifies user access tokens (HS256)

# ---- Gemini -----------------------------------------------------------------
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=4096

# ---- Embeddings (pluggable) -------------------------------------------------
EMBEDDINGS_PROVIDER=managed            # managed | fake | selfhosted
EMBEDDINGS_API_BASE=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-large
EMBEDDINGS_DIMENSION=1536              # MUST match vector(N) in the DB

# ---- App --------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000
STORAGE_BUCKET=documents
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
LOG_LEVEL=INFO
